<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Style x:Key="windowStyle" TargetType="Window" BasedOn="{StaticResource MaterialDesignWindow}">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="TextElement.FontFamily" Value="{materialDesign:MaterialDesignFont}" />
        <Setter Property="TextElement.FontSize" Value="20" />
        <Setter Property="TextElement.FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="userControlStyle" TargetType="UserControl">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="TextElement.FontFamily" Value="{materialDesign:MaterialDesignFont}" />
        <Setter Property="TextElement.FontSize" Value="20" />
        <Setter Property="TextElement.FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="statusBarStyle" TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="TextElement.FontFamily" Value="{materialDesign:MaterialDesignFont}" />
        <Setter Property="TextElement.FontSize" Value="20" />
        <Setter Property="TextElement.FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="listViewStyle" TargetType="ListView" BasedOn="{StaticResource MaterialDesignListView}">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="FontFamily" Value="{materialDesign:MaterialDesignFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="pageStyle" TargetType="Page">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="FontFamily" Value="{materialDesign:MaterialDesignFont}" />
        <Setter Property="FontSize" Value="20" />
    </Style>
</ResourceDictionary>