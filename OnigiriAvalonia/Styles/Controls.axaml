<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Base Window style (replaces WPF windowStyle with MaterialDesignWindow) -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Base UserControl style (replaces WPF userControlStyle) -->
  <Style Selector="UserControl">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Shared resources -->
  <Style Selector=":is(Control)">
    <Style.Resources>
      <SolidColorBrush x:Key="animeTitleBackground" Color="#BF000000" />
      <SolidColorBrush x:Key="transparentBrush" Color="Transparent" />
      <x:Double x:Key="cardWidth">800</x:Double>
      <x:Double x:Key="cardHeight">400</x:Double>
      <x:Double x:Key="cardWidthWithMargin">820</x:Double>
      <x:Double x:Key="cardHeightWithMargin">420</x:Double>
      <Thickness x:Key="cardMargin">10</Thickness>
    </Style.Resources>
  </Style>
</Styles>
