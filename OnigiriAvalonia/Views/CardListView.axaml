<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Finalspace.Onigiri.ViewModels"
             xmlns:models="using:Finalspace.Onigiri.Models"
             xmlns:controls="using:Finalspace.Onigiri.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="600"
             x:Class="Finalspace.Onigiri.Views.CardListView"
             x:DataType="vm:MainViewModel"
             x:Name="cardListView">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <ItemsRepeater ItemsSource="{Binding Animes}">
      <ItemsRepeater.Layout>
        <UniformGridLayout MinItemWidth="800" MinItemHeight="400"
                           MinColumnSpacing="10" MinRowSpacing="10" />
      </ItemsRepeater.Layout>
      <ItemsRepeater.ItemTemplate>
        <DataTemplate x:DataType="models:Anime">
          <Border Background="{DynamicResource animeItemBackground}"
                  CornerRadius="4"
                  ClipToBounds="True">
            <controls:AnimeCardControl Width="800" Height="400" />
          </Border>
        </DataTemplate>
      </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
  </ScrollViewer>
</UserControl>
