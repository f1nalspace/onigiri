<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Finalspace.Onigiri.Models"
             xmlns:converters="using:Finalspace.Onigiri.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="48"
             x:Class="Finalspace.Onigiri.Controls.UserStatesControl"
             x:DataType="models:Anime">

  <UserControl.Resources>
    <converters:UserImageConverter x:Key="userImgConv" />
    <converters:BoolToImageSourceConverter x:Key="markedConv"
        TrueImage="avares://OnigiriAvalonia/Resources/mark.png"
        FalseImage="avares://OnigiriAvalonia/Resources/mark_false.png" />
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom">

    <!-- Marked icon -->
    <Image Width="48" Height="48" Stretch="UniformToFill"
           Source="{Binding AddonData.Marked, Converter={StaticResource markedConv}}" />

    <!-- Watchlist -->
    <ItemsControl ItemsSource="{Binding AddonData.Watchstates}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="models:UserState">
          <Grid IsVisible="{Binding Value}">
            <Image Width="48" Height="48" Stretch="UniformToFill"
                   Source="{Binding UserName, Converter={StaticResource userImgConv}}" />
            <Image Width="32" Height="32"
                   Source="avares://OnigiriAvalonia/Resources/watch.png" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Deletelist -->
    <ItemsControl ItemsSource="{Binding AddonData.Deleteits}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="models:UserState">
          <Grid IsVisible="{Binding Value}">
            <Image Width="48" Height="48" Stretch="UniformToFill"
                   Source="{Binding UserName, Converter={StaticResource userImgConv}}" />
            <Image Width="32" Height="32"
                   Source="avares://OnigiriAvalonia/Resources/delete.png" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
